# URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000
# Display currency (ISO 4217) and conversion from the model's output currency (INR) into it.
# 13.8 = naira per 1 rupee, an approximate rate from early October 2026. Exchange rates move: update it.
VITE_CURRENCY=NGN
VITE_PRICE_MULTIPLIER=13.8
# Optional: your repository URL (the footer GitHub link is hidden/disabled when empty)
VITE_GITHUB_URL=
